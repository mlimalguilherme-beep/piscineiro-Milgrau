# Senha para entrar no painel (obrigatória)
ADMIN_PASSWORD="troque-esta-senha"

# Porta do servidor
PORT=3000

# Endereço público do app (usado no link de pagamento simulado)
APP_URL="http://localhost:3000"

# ---------- Asaas (gateway de pagamento) ----------
# Sem chave, o app funciona em MODO SIMULADO (links de pagamento falsos, para testar).
# Pegue a chave em: Asaas > Integrações > Chave de API
ASAAS_API_KEY=""
# "sandbox" para testes ou "production" para cobrar de verdade
ASAAS_ENV="sandbox"
# Token que você define ao cadastrar o webhook no Asaas (Integrações > Webhooks).
# URL do webhook: https://SEU-DOMINIO/api/webhooks/asaas
ASAAS_WEBHOOK_TOKEN=""
